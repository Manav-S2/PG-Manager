# ─────────────────────────────────────────────
#  AVRO — Environment Variables Template
#  Copy this to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────

# ── Supabase ─────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Firebase ─────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── AI ───────────────────────────────────────
# Gemini 2.5 Flash — get free key at: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# NVIDIA NIM fallback — get free key at: https://build.nvidia.com
EXPO_PUBLIC_NVIDIA_API_KEY=your-nvidia-nim-api-key
